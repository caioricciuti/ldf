---
// Starlight's header ends with the social icons. This puts the site's own
// links in front of them.
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/docs/", label: "Docs", active: path.startsWith("/docs/") && !path.startsWith("/docs/results/") },
  { href: "/docs/spec/", label: "Spec", active: path.startsWith("/docs/spec/") },
  { href: "/docs/results/baseline/", label: "Results", active: path.startsWith("/docs/results/") },
];
---

<nav class="ldf-links" aria-label="Site">
  {links.map((l) => (
    <a href={l.href} aria-current={l.active ? "page" : undefined}>{l.label}</a>
  ))}
</nav>
<Default />

<style>
  .ldf-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-end: 0.5rem;
  }
  .ldf-links a {
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .ldf-links a:hover,
  .ldf-links a[aria-current="page"] {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  @media (max-width: 50rem) {
    .ldf-links {
      display: none;
    }
  }
</style>
