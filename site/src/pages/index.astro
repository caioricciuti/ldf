    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .stat-l a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    white-space: nowrap;
  }
  .sample {
