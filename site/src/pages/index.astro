---
import Landing from "../layouts/Landing.astro";

const repo = "https://github.com/caioricciuti/ldf";
const reports = `${repo}/tree/main/reports`;

// `ldf-mcp convert` output for the JSON below, byte for byte. Token counts
// are `ldf-bench count` (o200k_base) on the LDF and on the JSON in compact
// form; the JSON is shown wrapped, one record per line.
const example = `@records id:s,customer.name:s,items:t,total:f,status:s
ORD-1,Val Thompson,2,715.94,shipped
ORD-2,Sol Ritchie,1,2757.03,cancelled
ORD-3,Kim Abara,2,53.78,shipped
@records.items id:s,sku:s,qty:i,price:f
ORD-1,E5,3,28.78
ORD-1,C3,4,157.4
ORD-2,A1,1,2757.03
ORD-3,B2,2,12.5
ORD-3,E5,1,28.78`;

const json = `[{"id":"ORD-1","customer":{"name":"Val Thompson"},
  "items":[{"sku":"E5","qty":3,"price":28.78},
           {"sku":"C3","qty":4,"price":157.4}],
  "total":715.94,"status":"shipped"},
 {"id":"ORD-2","customer":{"name":"Sol Ritchie"},
  "items":[{"sku":"A1","qty":1,"price":2757.03}],
  "total":2757.03,"status":"cancelled"},
 {"id":"ORD-3","customer":{"name":"Kim Abara"},
  "items":[{"sku":"B2","qty":2,"price":12.5},
           {"sku":"E5","qty":1,"price":28.78}],
  "total":53.78,"status":"shipped"}]`;

// What was measured and what it came to. Each row is copied from the report
// it links.
const findings = [
  ["LDF against compact JSON, irregular data", "20 to 64 percent fewer tokens", "2026-10-17-baseline"],
  ["Minifying a database MCP server's pretty JSON", "31 to 59 percent fewer on most results", "2026-10-21-columnar"],
  ["LDF on top of minified JSON, flat SQL results", "0.1 to 7 percent; one table 4 tokens larger", "2026-10-21-columnar"],
  ["LDF on top of minified JSON, structs and lists", "13 to 28 percent", "2026-10-21-columnar"],
  ["Claude Code session, LDF arm against JSON", "total prompt 3 percent larger (about 20 000 tokens, mostly Claude Code's own)", "2026-10-21-columnar"],
  ["SELECT * on 10 000 log rows", "1.4 MB as JSON, 683 KB as LDF; a size cap is what fixes it", "2026-10-21-columnar"],
];

// reports/2026-10-21-ni-study/README.md, the cells table.
const cells = [
  ["Opus 5.5", "flat_users", "151", "150 / 148", "1.2", "pass"],
  ["Opus 5.5", "nested_orders (hoisted)", "249", "238 / 247", "6.3", "fails"],
  ["Opus 5.5", "sparse_events", "220", "214 / 214", "2.6", "pass"],
  ["Opus 5.5", "mixed_types", "151", "151 / 150", "1.1", "pass"],
  ["Sonnet 5.5", "flat_users", "151", "148 / 150", "3.9", "inconclusive"],
  ["Sonnet 5.5", "nested_orders (0.75)", "249", "227 / 229", "3.5", "inconclusive"],
  ["Sonnet 5.5", "sparse_events", "220", "214 / 216", "3.6", "inconclusive"],
  ["Sonnet 5.5", "mixed_types", "151", "151 / 151", "1.8", "pass"],
  ["Sonnet 5.5", "sql_events (NULL as null)", "220", "216 / 217", "2.6", "pass"],
  ["DeepSeek", "flat_users", "151", "83 / 92", "10.7", "fails"],
  ["DeepSeek", "nested_orders (hoisted)", "249", "159 / 162", "3.7", "inconclusive"],
  ["DeepSeek", "sparse_events (0.75)", "220", "132 / 136", "5.5", "inconclusive"],
  ["DeepSeek", "mixed_types", "151", "150 / 150", "2.3", "pass"],
];
---

<Landing
  title="LDF: a token-efficient data format for LLMs, measured and set aside"
  description="A research project: a lossless table format for LLM tool output. It saves tokens, but minifying, result caps and agent context size make the saving small, and a pre-registered study proved it safe only for a few models and data shapes."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">Research project · concluded 2026-10-22</p>
        <h1 class="h1">A compact data format for LLMs. Measured, and not worth using.</h1>
        <p class="lead">
          LDF writes JSON records as typed tables: one header, one line per record, nothing lost. It
          does save tokens. But on real database tools most of the waste was whitespace, agents spend
          their context on their own prompts, and a pre-registered study found the format safe only
          for a few models and data shapes. This site keeps the results, the misses included.
        </p>
        <div class="cta">
          <a class="btn btn-light" href="/docs/writing/not-worth-it/">Read the write-up <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={reports}>Raw reports on GitHub</a>
        </div>
      </div>
      <div class="hero-sample" data-reveal>
        <div class="sample">
          <div class="sample-bar"><span>orders.ldf</span><span class="dim">143 tokens</span></div>
          <pre><code>{example}</code></pre>
        </div>
        <div class="sample faded">
          <div class="sample-bar"><span>the same data as JSON</span><span class="dim">169 tokens compact</span></div>
          <pre><code>{json}</code></pre>
        </div>
        <p class="sample-note">What the format looks like. The saving is real on data like this; the findings below are why it did not add up to much.</p>
      </div>
    </div>
    <ul class="container facts" data-reveal>
      <li><strong>It saves tokens.</strong> 20 to 64 percent against compact JSON on irregular data, lossless.</li>
      <li><strong>It rarely matters.</strong> Minifying gets most of the saving, and in an agent session tool results are a small share of the prompt.</li>
      <li><strong>It is proven safe narrowly.</strong> 6 of 13 study cells pass; one layout cost Opus 10 answers.</li>
    </ul>
  </section>

  <section class="section" id="findings">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Findings</p>
        <h2 class="h2">Where the tokens actually went.</h2>
        <p class="lead">
          o200k_base tokens unless stated. No model was called for these numbers except the Claude
          Code session; each row links its report.
        </p>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="numbers">
          <thead><tr><th>measured</th><th>result</th><th>report</th></tr></thead>
          <tbody>
            {findings.map(([what, result, dir]) => (
              <tr><td>{what}</td><td class="strong">{result}</td><td><a href={`${reports}/${dir}`}>{dir}</a></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="study">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">The study</p>
        <h2 class="h2">Does the model still answer correctly? <span class="soft">Sometimes provably.</span></h2>
        <p class="lead">
          Pre-registered before the first response: 200 held-out records, the same questions in both
          formats, and LDF passes only if the one-sided 95 percent bound on its loss against JSON is at
          most 3 points. Earlier evaluations with 52 to 95 questions per cell were too small to show
          that; this one cost $21.
        </p>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="numbers">
          <thead><tr><th>model</th><th>data</th><th>questions</th><th>LDF / JSON correct</th><th>loss bound (pp)</th><th>verdict</th></tr></thead>
          <tbody>
            {cells.map(([model, data, n, score, bound, verdict]) => (
              <tr><td>{model}</td><td>{data}</td><td>{n}</td><td>{score}</td><td>{bound}</td><td class={verdict === "pass" ? "pass" : verdict === "fails" ? "fail" : ""}>{verdict}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note" data-reveal>Haiku 5.5 and GPT were not in the study and have no passing evidence. <a href={`${reports}/2026-10-21-ni-study`}>Study report, pre-registration and raw responses</a>.</p>
    </div>
  </section>

  <section class="section" id="instead">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Instead</p>
        <h2 class="h2">What does save tokens.</h2>
      </div>
      <ol class="instead" data-reveal>
        <li><strong>Minify tool output.</strong> Free and safe, for every model.</li>
        <li><strong>Check which copy your client reads.</strong> FastMCP sends each result twice; Claude Code shows the model <code>structuredContent</code>, not the text.</li>
        <li><strong>Cap big results.</strong> Keep the rows that fit and tell the model how to narrow the query.</li>
        <li><strong>Count the questions.</strong> Under about 90 per cell, a "no loss" result cannot rule out a 3-point loss.</li>
      </ol>
    </div>
  </section>

  <section class="section" id="status">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Status</p>
        <h2 class="h2">No longer developed. <span class="soft">Everything stays readable.</span></h2>
        <p class="lead">
          The Rust workspace, the specification, the evaluation harness and every report stay public.
          The crates on crates.io remain as published and will not be updated.
        </p>
        <div class="cta">
          <a class="btn btn-light" href="/docs/">Documentation <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={repo}>Source on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Landing>

<style>
  .hero {
    padding: calc(7rem + env(safe-area-inset-top, 0px)) 0 clamp(3rem, 7vw, 5rem);
    background: radial-gradient(60% 50% at 70% 0%, var(--mint-glow), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.8vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 680;
    margin: 1rem 0 0;
    text-wrap: balance;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .facts {
    list-style: none;
    margin-block: clamp(3rem, 6vw, 4.5rem) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem 2.5rem;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .facts li {
    padding-top: 1rem;
    border-top: 1px solid var(--line-2);
  }
  .facts strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .hero-sample {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .sample-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .sample {
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--bg-2);
    overflow: hidden;
    min-width: 0;
  }
  .sample.faded {
    opacity: 0.72;
  }
  .sample-bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-2);
  }
  .sample-bar .dim {
    color: var(--dim);
  }
  .sample pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text);
  }
  .sample code {
    white-space: pre;
  }
  .table-wrap {
    margin-top: 2.5rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }
  .numbers {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .numbers th,
  .numbers td {
    text-align: left;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .numbers th {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    font-weight: 600;
    white-space: nowrap;
  }
  .numbers tbody tr:last-child td {
    border-bottom: 0;
  }
  .numbers .strong {
    color: var(--mint);
    font-weight: 600;
  }
  .numbers .pass {
    color: var(--added);
    font-weight: 600;
  }
  .numbers .fail {
    color: var(--removed);
    font-weight: 600;
  }
  .numbers a {
    white-space: nowrap;
  }
  .numbers a,
  .note a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
  }
  .note {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .instead {
    margin: 2.5rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.9rem;
    color: var(--text-2);
    max-width: 46rem;
  }
  .instead strong {
    color: var(--text);
  }
  .instead code,
  .lead code {
    font-size: 0.9em;
    color: var(--text);
  }
  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
