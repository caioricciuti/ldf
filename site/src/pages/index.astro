    gap: 1rem;
    margin-top: 2.5rem;
  }
  .stat-l a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    white-space: nowrap;
  }
  .sample {
    border: 1px solid var(--line-2);
