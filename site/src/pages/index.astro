    gap: 1rem;
    margin-top: 1.5rem;
    color: var(--text-2);
    font-size: 0.93rem;
  }
  .mcp-points a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
  }
