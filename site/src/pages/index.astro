    border-top: 1px solid var(--line-2);
  }
  .facts strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .install {
    margin-top: 2rem;
    max-width: 34rem;
  }
  .install pre {
    color: var(--mint);
  }
  .hero-sample {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .sample-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
