    padding-top: 1rem;
    border-top: 1px solid var(--line-2);
  }
  .facts strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .install {
    margin-top: 2rem;
    max-width: 34rem;
  }
  .install pre {
