---
// The landing page. Starlight owns /docs; this layout is everything else:
// one dark look, the same nav and footer on every page.
import "../styles/landing.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const repo = "https://github.com/caioricciuti/ldf";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0c0c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script
      is:inline
      defer
      src="https://a.caioricciuti.com/b.js"
      data-website-id="1a84e1c7-763c-4551-8bc7-aaa3b6e79eae"
    ></script>
  </head>
  <body>
    <header class="nav" data-nav>
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="LDF home">
          <img src="/favicon.svg" alt="" width="26" height="26" />
          <span>LDF</span>
        </a>
        <nav class="nav-links" aria-label="Main">
          <a href="/#findings">Findings</a>
          <a href="/#study">Study</a>
          <a href="/docs/writing/not-worth-it/">Write-up</a>
          <a href="/docs/">Docs</a>
          <a href="/docs/spec/">Spec</a>
        </nav>
        <div class="nav-actions">
          <a class="icon-link" href={repo} aria-label="LDF on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a class="btn btn-small btn-light" href="/docs/writing/not-worth-it/">Read the write-up</a>
          <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
            <span></span><span></span>
          </button>
        </div>
      </div>
      <div class="mobile-menu" data-mobile-menu hidden>
        <a href="/#findings">Findings</a>
        <a href="/#study">Study</a>
        <a href="/docs/writing/not-worth-it/">Write-up</a>
        <a href="/docs/">Docs</a>
        <a href="/docs/spec/">Spec</a>
        <a href={repo}>GitHub</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <img src="/favicon.svg" alt="" width="26" height="26" />
            <span>LDF</span>
          </a>
          <p>Language Data Format. A research project on token-efficient data for language models, concluded 2026-10-22. Free software, MIT or Apache-2.0.</p>
        </div>
        <div>
          <h3>Format</h3>
          <a href="/docs/format/">In five minutes</a>
          <a href="/docs/spec/">Specification</a>
          <a href="/docs/design/">Design candidates</a>
          <a href="/docs/research/">Research notes</a>
        </div>
        <div>
          <h3>Code</h3>
          <a href="/docs/mcp/">ldf-mcp</a>
          <a href="/docs/working-notes/">Working notes</a>
          <a href="/docs/contributing/">Contributing</a>
          <a href="/docs/changelog/">Changelog</a>
          <a href={repo}>Source</a>
        </div>
        <div>
          <h3>Evidence</h3>
          <a href="/docs/results/baseline/">Baseline report</a>
          <a href="/docs/methodology/">Methodology</a>
          <a href="/docs/writing/not-worth-it/">Write-up</a>
          <a href="/docs/evidence/">Evidence chart</a>
        </div>
      </div>
      <div class="container footer-base">
        <span>MIT or Apache-2.0</span>
        <span>Every number on this site comes from a file the benchmark wrote.</span>
      </div>
    </footer>

    <script>
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
      toggle?.addEventListener("click", () => {
        if (!menu) return;
        const open = menu.hidden;
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("open", open);
      });
      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu.hidden = true;
          toggle?.setAttribute("aria-expanded", "false");
          nav?.classList.remove("open");
        }),
      );

      // Sections fade in once as they reach the viewport.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
