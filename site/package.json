    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.4.2"
}
