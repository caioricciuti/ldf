{
  "name": "ldf-site",
  "private": true,
  "description": "ldflabs.org: the landing page and docs for LDF, built with Starlight from the Markdown in the repository.",
  "type": "module",
  "scripts": {
    "sync": "bun run scripts/sync-docs.mjs",
